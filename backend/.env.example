# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- General ---
APP_NAME="Fathir AI Trading Assistant"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- API security ---
# Shared-secret header required on non-public endpoints (X-API-Key).
# In `development` with the default placeholder value, auth is skipped for
# convenience — ALWAYS set a real key before deploying anywhere reachable.
API_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:5173

# --- Database ---
# SQLite by default. For Postgres:
#   DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/fathir
DATABASE_URL=sqlite:///./data/fathir.db

# --- Credential encryption (required if you store broker creds in the DB) ---
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# --- Broker (MetaTrader 5) ---
# "mock" runs a deterministic synthetic market so the whole app works
# without a live terminal. Switch to "mt5" only on a Windows host that has
# the MetaTrader5 terminal installed and running.
BROKER_MODE=mock
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=
MT5_TIMEOUT_MS=10000

DEFAULT_SYMBOL=EURUSD
DEFAULT_TIMEFRAME=H1

# --- Risk defaults (per-account overrides live in the risk_settings table) ---
DEFAULT_RISK_PERCENT=1.0
DEFAULT_MAX_DAILY_LOSS_PERCENT=3.0
DEFAULT_MAX_TRADES_PER_DAY=5
DEFAULT_MAX_DRAWDOWN_PERCENT=10.0

# --- AI / LLM provider (Anthropic) ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_VISION_MODEL=claude-sonnet-4-5-20250929
AI_REQUEST_TIMEOUT_SECONDS=30

# --- Telegram ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# --- News / economic calendar ---
NEWS_API_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
NEWS_HIGH_IMPACT_LOOKAHEAD_MINUTES=60
NEWS_CHECK_INTERVAL_MINUTES=15

# --- Scheduler ---
MARKET_POLL_INTERVAL_SECONDS=60
DAILY_SUMMARY_HOUR_UTC=21

# --- Uploads ---
MAX_SCREENSHOT_SIZE_MB=8
