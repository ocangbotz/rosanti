# Copy to `.env.local` for local overrides. Vite only exposes variables
# prefixed with VITE_ to client code.

# Base URL of the backend API. Leave unset in dev to use the Vite proxy
# (see vite.config.ts), which forwards /api and /ws to localhost:8000.
VITE_API_BASE_URL=

# Base URL of the backend WebSocket endpoint (e.g. wss://api.example.com).
# Leave unset to derive it from the current page's origin (ws:// on http,
# wss:// on https) — correct for both the Vite dev proxy and the nginx
# production proxy, which is why this is blank by default.
VITE_WS_BASE_URL=

# Must match the backend's API_KEY once you've set a real one (see
# backend/.env.example). Leave blank while the backend is still running
# with its zero-config development bypass.
VITE_API_KEY=
